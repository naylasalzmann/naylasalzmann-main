---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { Icon } from 'astro-icon/components'
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/tour">Tour</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.youtube.com/@naylasalzmann" target="_blank">
				<span class="sr-only">Follow Nayla Salzmann on YouTube</span>
				<Icon name="youtube" size={32} />
			</a>
			<a href="https://open.spotify.com/artist/41J6ppdYoUtSogli4x9Jxo" target="_blank">
				<span class="sr-only">Listen to Nayla Salzmann on Spotify</span>
				<Icon name="spotify" size={32} />
			</a>
			<a href="https://naylasalzmann.bandcamp.com" target="_blank">
				<span class="sr-only">Follow Nayla Salzmann on Bandcamp</span>
				<Icon name="bandcamp" size={32} />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
