---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header class="sidebar">
  <input type="checkbox" id="nav-toggle" class="sr-only" />
  <div class="sidebar-header">
    <h2 class="site-title"><a href="/">{SITE_TITLE}</a></h2>
    <label
      for="nav-toggle"
      class="hamburger"
      aria-label="Toggle navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </label>
  </div>
  <div class="nav-panel">
    <nav class="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/tour">Tour</HeaderLink>
      <HeaderLink href="/music">Music</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
    </nav>
  </div>
</header>
<style>
  .sidebar {
    position: fixed;
    top: 1.5em;
    left: 1em;
    width: auto;
    max-width: 180px;
    z-index: 10;
  }
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0;
  }
  .site-title {
    display: none;
    margin: 0;
    font-size: 1.1em;
  }
  .site-title a {
    color: #fff;
    text-decoration: none;
  }
  .nav-panel {
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  .internal-links {
    display: flex;
    flex-direction: column;
  }
  #nav-toggle {
    display: none;
  }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
  }
  .hamburger span {
    width: 22px;
    height: 2px;
    background: #fff;
  }
  #nav-toggle:focus ~ .sidebar-header .hamburger {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  @media (max-width: 720px) {
    .sidebar {
      width: 100%;
      max-width: none;
      height: auto;
      position: static;
    }
    .site-title {
      display: block;
    }
    #nav-toggle {
      display: block;
    }
    .hamburger {
      display: flex;
    }
    .nav-panel {
      display: none;
      padding: 0 1em 1em;
    }
    #nav-toggle:checked ~ .nav-panel {
      display: flex;
    }
  }
</style>
