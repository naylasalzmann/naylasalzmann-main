---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="dark">
		<div class="app-shell">
			<Header />
			<div class="page">
				<main><slot /></main>
				<Footer />
			</div>
		</div>
	</body>
</html>
<style>
	.app-shell {
		display: flex;
		min-height: 100vh;
	}
	.page {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	main {
		flex: 1 1 auto;
		width: 100%;
		padding: 3em 1em;
	}
	@media (max-width: 720px) {
		.app-shell {
			flex-direction: column;
		}
		main {
			padding: 1em;
		}
	}
</style>
