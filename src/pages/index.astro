---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE, YOUTUBE_URL } from "../consts";

const releases = await getCollection("releases");
const currentRelease = releases.find((release) => release.data.current);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <style>
    .hero {
      position: relative;
      max-width: 480px;
      margin-inline: auto;
      text-align: center;
    }
    .eyebrow {
      position: absolute;
      top: 0;
      left: 100%;
      margin: 0 0 0 1em;
      white-space: nowrap;
      color: var(--brand-accent);
      font-weight: bold;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      font-size: 0.9em;
    }
    @media (max-width: 720px) {
      .eyebrow {
        position: static;
        margin: 0 0 0.75em 0;
        white-space: normal;
      }
    }
    .image-wrapper {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 4px;
    }
    .image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 4px;
    }
    .title {
      margin: 1em 0 0 0;
      color: rgb(var(--gray-light));
    }
    .cta-row {
      display: flex;
      gap: 1em;
      margin-top: 1.5em;
    }
    .cta-button {
      flex: 1;
      padding: 0.9em 1.5em;
      border: 2px solid var(--brand-accent);
      border-radius: 4px;
      color: var(--brand-accent);
      text-decoration: none;
      font-weight: bold;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.85em;
      transition:
        background 0.2s,
        color 0.2s;
    }
    .cta-button:hover {
      background: var(--brand-accent);
      color: #fff;
    }
  </style>
  {
    currentRelease && (
      <div class="hero">
        <p class="eyebrow">Out Now</p>
        <div class="image-wrapper">
          <Image
            width={800}
            height={800}
            src={currentRelease.data.image}
            alt={currentRelease.data.title}
          />
        </div>
        <h3 class="title">{currentRelease.data.title}</h3>
        <div class="cta-row">
          <a
            class="cta-button"
            href={currentRelease.data.listenUrl}
            target="_blank"
            rel="noopener"
          >
            Listen
          </a>
          <a
            class="cta-button"
            href={currentRelease.data.watchUrl ?? YOUTUBE_URL}
            target="_blank"
            rel="noopener"
          >
            Watch
          </a>
        </div>
      </div>
    )
  }
</BaseLayout>
